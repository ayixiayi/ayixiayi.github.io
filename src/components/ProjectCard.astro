---
import {
  projectStatusLabels,
  projectUrl,
  type ProjectEntry,
} from '../lib/projects';
import Icon from './Icon.astro';
import ProjectMotif from './ProjectMotif.astro';

interface Props {
  project: ProjectEntry;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { data } = project;
---

<article
  class="project-card"
  id={project.id}
  tabindex="-1"
  data-reveal
  style={`--reveal-delay: ${index * 90}ms`}
>
  <span class="work-no" aria-hidden="true">
    {String(index + 1).padStart(2, '0')}
  </span>
  <ProjectMotif motif={data.motif} />
  <div class="work-body">
    <p class="work-meta">
      {projectStatusLabels[data.status]} · {data.period}
    </p>
    <h3>
      <a class="card-link" href={projectUrl(project)}>
        {data.title}
        <span class="card-icon" aria-hidden="true">
          <Icon name="arrow" size={17} />
        </span>
      </a>
    </h3>
    <p>{data.summary}</p>
    <ul class="project-tags" aria-label="技术标签">
      {data.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <a
      class="repo-link"
      href={data.repo}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="external" size={14} /> GitHub
      <span class="sr-only">（{data.title} 仓库，新窗口）</span>
    </a>
  </div>
</article>
