---
import { projects } from '../data/site';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---

<div class:list={['work-list', { 'home-projects': home }]}>
  {projects.map((project, index) => (
    <div class="project-entry">
      <ProjectCard project={project} index={index} />
      {'example' in project && (
        <a class="example-link" href={project.example.url}>
          {project.example.title} <Icon name="arrow" size={16} />
        </a>
      )}
    </div>
  ))}
</div>

<style>
  .project-entry {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-bottom: 1px solid var(--rule);
  }
  .project-entry > :global(.project-card) {
    flex: 1;
    border-bottom: 0;
  }
  .example-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    min-height: 44px;
    margin: -12px 0 12px;
    font-size: 13px;
    color: var(--gold);
  }
  .example-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
