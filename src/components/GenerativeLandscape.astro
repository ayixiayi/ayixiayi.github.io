---
import { DEFAULT_SEED } from '../art/landscape';
import Icon from './Icon.astro';
---

<generative-landscape data-seed={DEFAULT_SEED} data-state="poster">
  <div
    class="landscape-surface"
    role="img"
    aria-label="青灰色山谷与远处的金色宫殿"
  >
    <div class="landscape-layer">
      <img
        data-art-fallback
        src="/images/landscape.webp"
        alt=""
        width="1600"
        height="1000"
        fetchpriority="high"
      />
      <div data-canvas-host aria-hidden="true"></div>
    </div>
    <div class="landscape-glaze" aria-hidden="true"></div>
  </div>
  <div class="landscape-caption">
    <span class="art-progress" aria-hidden="true">
      <span data-art-progress></span>
    </span>
    <div class="label-details">
      <p class="label-title">远方的宫殿</p>
      <p class="label-medium">Canvas 2D · 噪声与笔触</p>
    </div>
    <div class="label-controls">
      <span data-art-status class="art-status" role="status">
        seed {DEFAULT_SEED}
      </span>
      <div class="label-actions" data-actions hidden>
        <button type="button" data-random hidden aria-label="重新生成图像">
          <Icon name="shuffle" size={15} /> 重新生成
        </button>
        <button
          type="button"
          data-copy
          aria-label="复制这幅画的链接"
          title="复制这幅画的链接"
        >
          <Icon name="link" size={15} />
          <span>复制链接</span>
        </button>
        <button
          type="button"
          data-download
          aria-label="下载这幅画"
          title="下载这幅画"
        >
          <Icon name="download" size={15} />
          <span>下载</span>
        </button>
      </div>
    </div>
  </div>
</generative-landscape>

<script>
  import type { LandscapeHandle } from '../art/landscape';

  class GenerativeLandscape extends HTMLElement {
    private renderer?: LandscapeHandle;
    private disposed = false;
    private snapshotUrl?: string;
    private controller?: AbortController;
    private noteTimer = 0;
    private pointerFrame = 0;

    connectedCallback() {
      this.disposed = false;
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;

      const surface = this.querySelector<HTMLElement>('.landscape-surface')!;
      const host = this.querySelector<HTMLElement>('[data-canvas-host]')!;
      const fallback = this.querySelector<HTMLImageElement>(
        '[data-art-fallback]',
      )!;
      const status = this.querySelector<HTMLElement>('[data-art-status]')!;
      const progress = this.querySelector<HTMLElement>('[data-art-progress]')!;
      const random = this.querySelector<HTMLButtonElement>('[data-random]')!;
      const actions = this.querySelector<HTMLElement>('[data-actions]')!;
      const copy = this.querySelector<HTMLButtonElement>('[data-copy]')!;
      const download =
        this.querySelector<HTMLButtonElement>('[data-download]')!;
      let seed = Number(this.dataset.seed);
      let displayedSeed = seed;
      let fallbackSeed = seed;
      let busy = false;
      let downloading = false;
      let restoreFocus = false;

      const setBusy = (value: boolean) => {
        if (value) restoreFocus = document.activeElement === random;
        busy = value;
        random.disabled = value;
        copy.disabled = value;
        download.disabled = value;
        surface.setAttribute('aria-busy', String(value));
        if (!value && restoreFocus && document.activeElement === document.body)
          random.focus({ preventScroll: true });
      };

      // The finished painting stays underneath while the next one is laid over it.
      const keepCurrentPainting = async () => {
        const canvas = host.querySelector('canvas');
        if (!canvas || this.dataset.state !== 'ready') return;
        const blob = await new Promise<Blob | null>((resolve) =>
          canvas.toBlob(resolve, 'image/webp', 0.92),
        );
        if (!blob || this.disposed) return;
        const next = URL.createObjectURL(blob);
        const image = new Image();
        image.src = next;
        try {
          await image.decode();
        } catch (error) {
          URL.revokeObjectURL(next);
          throw error;
        }
        if (this.disposed) {
          URL.revokeObjectURL(next);
          return;
        }
        const previous = this.snapshotUrl;
        this.snapshotUrl = next;
        fallback.src = next;
        fallbackSeed = displayedSeed;
        if (previous) URL.revokeObjectURL(previous);
      };

      const updateSeedUrl = () => {
        const url = new URL(location.href);
        url.searchParams.set('seed', String(displayedSeed));
        history.replaceState(null, '', url);
      };

      const handleRenderError = () => {
        if (this.disposed) return;
        this.renderer?.remove();
        this.renderer = undefined;
        host.replaceChildren();
        displayedSeed = fallbackSeed;
        this.dataset.state = 'error';
        status.textContent = '生成失败，请重试';
        updateSeedUrl();
        setBusy(false);
      };

      const render = async () => {
        if (busy) return;
        window.clearTimeout(this.noteTimer);
        this.noteTimer = 0;
        setBusy(true);
        try {
          await keepCurrentPainting();
        } catch {
          // Keep the last successfully decoded fallback and its seed together.
        }
        if (this.disposed) return;
        this.dataset.state = 'loading';
        progress.style.transform = 'scaleX(0)';
        status.textContent = '正在生成…';
        try {
          const { renderLandscape } = await import('../art/landscape');
          if (this.disposed) return;
          this.renderer?.remove();
          this.renderer = undefined;
          host.replaceChildren();
          let failed = false;
          const instance = renderLandscape(host, {
            seed,
            width: 1600,
            height: 1000,
            onProgress: (done) => {
              if (this.disposed) return;
              if (this.dataset.state === 'loading')
                this.dataset.state = 'painting';
              progress.style.transform = `scaleX(${done})`;
            },
            onComplete: () => {
              if (this.disposed) return;
              displayedSeed = seed;
              this.dataset.state = 'ready';
              status.textContent = `seed ${displayedSeed}`;
              updateSeedUrl();
              setBusy(false);
            },
            onError: () => {
              failed = true;
              handleRenderError();
            },
          });
          if (failed || this.disposed) {
            instance.remove();
            host.replaceChildren();
          } else {
            this.renderer = instance;
          }
        } catch {
          handleRenderError();
        }
      };

      // Brief confirmations share the status line, then hand it back to the seed.
      const note = (message: string) => {
        if (busy) return;
        window.clearTimeout(this.noteTimer);
        status.textContent = message;
        this.noteTimer = window.setTimeout(() => {
          this.noteTimer = 0;
          if (!busy && !this.disposed)
            status.textContent =
              this.dataset.state === 'error'
                ? '生成失败，请重试'
                : `seed ${displayedSeed}`;
        }, 2400);
      };

      // The poster is the default seed, so a link always reproduces what is shown.
      copy.addEventListener(
        'click',
        async () => {
          if (busy) return;
          const url = new URL('/', location.origin);
          url.searchParams.set('seed', String(displayedSeed));
          try {
            await navigator.clipboard.writeText(url.href);
            note('已复制链接');
          } catch {
            note(url.href);
          }
        },
        { signal },
      );

      download.addEventListener(
        'click',
        async () => {
          if (busy || downloading) return;
          downloading = true;
          let objectUrl: string | undefined;
          try {
            const canvas = host.querySelector('canvas');
            const downloadSeed = displayedSeed;
            const link = document.createElement('a');
            if (canvas && this.dataset.state === 'ready') {
              const blob = await new Promise<Blob | null>((resolve) =>
                canvas.toBlob(resolve, 'image/png'),
              );
              if (!blob) {
                note('下载失败，请重试');
                return;
              }
              objectUrl = URL.createObjectURL(blob);
              link.href = objectUrl;
              link.download = `ayixiayi-seed-${downloadSeed}.png`;
            } else {
              link.href = fallback.src;
              link.download = `ayixiayi-seed-${downloadSeed}.webp`;
            }
            link.click();
            if (objectUrl) {
              const url = objectUrl;
              objectUrl = undefined;
              window.setTimeout(() => URL.revokeObjectURL(url), 30000);
            }
          } catch {
            if (objectUrl) URL.revokeObjectURL(objectUrl);
            note('下载失败，请重试');
          } finally {
            downloading = false;
          }
        },
        { signal },
      );

      random.hidden = false;
      actions.hidden = false;
      random.addEventListener(
        'click',
        () => {
          if (busy) return;
          seed =
            ((seed + (crypto.getRandomValues(new Uint32Array(1))[0] % 999998)) %
              999999) +
            1;
          void render();
        },
        { signal },
      );

      // A soft gallery light follows the pointer across the canvas.
      if (
        matchMedia(
          '(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)',
        ).matches
      ) {
        surface.addEventListener(
          'pointermove',
          (event) => {
            if (this.pointerFrame) return;
            const { clientX, clientY } = event;
            this.pointerFrame = requestAnimationFrame(() => {
              this.pointerFrame = 0;
              if (this.disposed) return;
              const box = surface.getBoundingClientRect();
              if (!box.width || !box.height) return;
              surface.style.setProperty(
                '--light-x',
                `${(((clientX - box.left) / box.width) * 100).toFixed(1)}%`,
              );
              surface.style.setProperty(
                '--light-y',
                `${(((clientY - box.top) / box.height) * 100).toFixed(1)}%`,
              );
            });
          },
          { signal },
        );
      }

      const requestedSeed = Number(
        new URLSearchParams(location.search).get('seed'),
      );
      if (
        Number.isInteger(requestedSeed) &&
        requestedSeed >= 1 &&
        requestedSeed <= 999999
      ) {
        seed = requestedSeed;
        void render();
      }
    }

    disconnectedCallback() {
      this.disposed = true;
      this.controller?.abort();
      this.controller = undefined;
      window.clearTimeout(this.noteTimer);
      this.noteTimer = 0;
      if (this.pointerFrame) {
        cancelAnimationFrame(this.pointerFrame);
        this.pointerFrame = 0;
      }
      this.renderer?.remove();
      this.renderer = undefined;
      if (this.snapshotUrl) {
        URL.revokeObjectURL(this.snapshotUrl);
        this.snapshotUrl = undefined;
      }
    }
  }

  if (!customElements.get('generative-landscape'))
    customElements.define('generative-landscape', GenerativeLandscape);
</script>
