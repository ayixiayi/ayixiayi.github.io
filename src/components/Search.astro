<button
  id="search-trigger"
  class="search-trigger"
  type="button"
  aria-label="搜索站点"
  aria-haspopup="dialog"
  title="搜索站点（Ctrl/⌘ K）"
  hidden
>
  <svg
    width="17"
    height="17"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    aria-hidden="true"
  >
    <circle cx="10.5" cy="10.5" r="6.5" />
    <path d="m16 16 4.5 4.5" />
  </svg>
</button>

<dialog id="site-search" aria-labelledby="search-title">
  <div class="search-heading">
    <h2 id="search-title">搜索</h2>
    <button id="search-close" type="button" aria-label="关闭搜索">
      关闭
    </button>
  </div>
  <label for="search-input">搜索内容</label>
  <input
    id="search-input"
    type="search"
    placeholder="文章或项目"
    autocomplete="off"
    autofocus
  />
  <p id="search-status" role="status" aria-live="polite">
    输入关键词
  </p>
  <button id="search-retry" type="button" hidden>
    重试
  </button>
  <ul id="search-results" aria-label="搜索结果"></ul>
</dialog>

<script>
  type SearchEntry = {
    title: string;
    description: string;
    url: string;
    kind: string;
    text: string;
  };

  const trigger = document.getElementById('search-trigger');
  const dialog = document.getElementById('site-search');
  const input = document.getElementById('search-input');
  const close = document.getElementById('search-close');
  const retry = document.getElementById('search-retry');
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');

  if (
    trigger instanceof HTMLButtonElement &&
    dialog instanceof HTMLDialogElement &&
    input instanceof HTMLInputElement &&
    close &&
    retry &&
    status &&
    results
  ) {
    let entries: SearchEntry[] | null = null;
    let loading = false;
    let focusAfterClose: HTMLElement = trigger;
    const normalize = (value: string) =>
      value.normalize('NFKC').toLowerCase().trim();

    function render() {
      if (!entries || !input || !results || !status) return;
      const terms = normalize((input as HTMLInputElement).value)
        .split(/\s+/u)
        .filter(Boolean);
      const matches = entries.filter((entry) => {
        const content = normalize(
          `${entry.title} ${entry.description} ${entry.text}`,
        );
        return terms.every((term) => content.includes(term));
      });
      results.replaceChildren();
      status.textContent =
        matches.length === 0
          ? '没有找到匹配的内容'
          : terms.length
            ? `找到 ${matches.length} 项内容`
            : `全部 ${matches.length} 项内容`;
      for (const entry of matches) {
        const url = new URL(entry.url, window.location.origin);
        if (url.protocol !== 'https:' && url.protocol !== 'http:') continue;
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = url.href;
        if (url.origin !== window.location.origin) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
        const kind = document.createElement('span');
        kind.className = 'result-kind';
        kind.textContent = entry.kind;
        const title = document.createElement('strong');
        title.textContent = entry.title;
        const description = document.createElement('p');
        description.textContent =
          entry.description.length > 180
            ? `${entry.description.slice(0, 180)}…`
            : entry.description;
        link.append(kind, title, description);
        item.append(link);
        results.append(item);
      }
    }

    async function loadIndex() {
      if (loading || !retry || !status || !results) return;
      if (entries) {
        render();
        return;
      }
      loading = true;
      retry.hidden = true;
      results.replaceChildren();
      status.textContent = '正在加载搜索内容…';
      try {
        const response = await fetch('/search-index.json');
        if (!response.ok) throw new Error('Search index unavailable');
        const data: unknown = await response.json();
        if (
          !Array.isArray(data) ||
          !data.every(
            (entry) =>
              entry &&
              ['title', 'description', 'url', 'kind', 'text'].every(
                (key) => typeof entry[key] === 'string',
              ) &&
              URL.canParse(entry.url, window.location.origin),
          )
        ) {
          throw new Error('Invalid search index');
        }
        entries = data;
        render();
      } catch {
        entries = null;
        status.textContent = '搜索暂时不可用，请重试。';
        retry.hidden = false;
      } finally {
        loading = false;
      }
    }

    function openSearch() {
      if (
        !(dialog instanceof HTMLDialogElement) ||
        !(input instanceof HTMLInputElement) ||
        dialog.open
      )
        return;
      dialog.showModal();
      input.focus();
      void loadIndex();
    }

    trigger.addEventListener('click', openSearch);
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      focusAfterClose.focus({ preventScroll: true });
      focusAfterClose = trigger;
    });
    results.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;
      const link =
        event.target instanceof Element ? event.target.closest('a') : null;
      if (
        !link ||
        link.origin !== window.location.origin ||
        link.pathname !== window.location.pathname ||
        link.search !== window.location.search ||
        !link.hash
      )
        return;
      const destination = document.getElementById(
        decodeURIComponent(link.hash.slice(1)),
      );
      if (!destination) return;
      focusAfterClose = destination;
      dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !event.isComposing) {
        // Search inputs consume Escape to clear their value before the dialog can close.
        event.preventDefault();
        dialog.close();
      }
    });
    dialog.addEventListener('click', (event) => {
      const bounds = dialog.getBoundingClientRect();
      if (
        event.target === dialog &&
        (event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom)
      )
        dialog.close();
    });
    input.addEventListener('input', render);
    retry.addEventListener('click', () => {
      void loadIndex();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openSearch();
      }
    });
    trigger.hidden = false;
  }
</script>

<style>
  .search-trigger {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fog);
    font: inherit;
    cursor: pointer;
  }
  .search-trigger[hidden],
  #search-retry[hidden] {
    display: none;
  }
  .search-trigger svg {
    transition:
      scale 400ms var(--ease-out),
      rotate 400ms var(--ease-out);
  }
  .search-trigger:hover {
    color: var(--gold);
  }
  .search-trigger:hover svg {
    scale: 1.1;
    rotate: -8deg;
  }
  /* A sheet lowered from the top of the page, like a catalogue index. */
  dialog {
    width: min(760px, calc(100vw - 2rem));
    max-height: min(78vh, 760px);
    margin-top: 10vh;
    padding: 2rem 2.25rem 1.5rem;
    box-sizing: border-box;
    border: 1px solid var(--rule);
    border-top: 1px solid var(--gold);
    border-radius: 0;
    background: var(--ink-raised);
    color: var(--fog);
    font-family: var(--font-sans);
    overflow: auto;
    box-shadow: 0 50px 120px -40px rgb(0 0 0 / 80%);
  }
  dialog[open] {
    animation: dialog-in 560ms var(--ease-out);
  }
  dialog::backdrop {
    background: rgb(6 10 12 / 76%);
    backdrop-filter: blur(8px);
  }
  dialog[open]::backdrop {
    animation: backdrop-in 560ms ease;
  }
  @keyframes dialog-in {
    from {
      opacity: 0;
      translate: 0 -18px;
    }
  }
  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }
  @keyframes result-in {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  .search-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--snow);
  }
  #search-close,
  #search-retry {
    padding: 0.4rem 0;
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--fog);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      color 300ms ease,
      border-color 300ms ease;
  }
  #search-close:hover,
  #search-retry:hover {
    color: var(--gold);
    border-color: var(--gold);
  }
  label {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--mist);
    font-size: 0.8rem;
  }
  input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.5rem 0 0.75rem;
    border: 0;
    border-bottom: 1px solid var(--rule-strong);
    border-radius: 0;
    background: transparent;
    color: var(--snow);
    font-family: var(--font-display);
    font-size: 1.75rem;
    transition: border-color 400ms ease;
  }
  input:focus {
    border-bottom-color: var(--gold);
  }
  input::placeholder {
    color: var(--mist);
  }
  #search-status {
    margin: 1rem 0 0.5rem;
    color: var(--mist);
    font: 0.75rem var(--font-mono);
  }
  #search-results {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #search-results :global(li) {
    animation: result-in 460ms var(--ease-out) backwards;
  }
  #search-results :global(li + li) {
    border-top: 1px solid var(--rule);
  }
  #search-results :global(a) {
    display: block;
    padding: 1rem 0.75rem;
    margin-inline: -0.75rem;
    color: var(--fog);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color 300ms ease;
  }
  #search-results :global(a:hover) {
    background: var(--ink-soft);
  }
  #search-results :global(.result-kind) {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--gold);
    font: 0.7rem var(--font-mono);
    letter-spacing: 0.1em;
  }
  #search-results :global(strong) {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--snow);
  }
  #search-results :global(p) {
    margin: 0.3rem 0 0;
    color: var(--mist);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  button:focus-visible,
  input:focus-visible,
  #search-results :global(a:focus-visible) {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
  @media (max-width: 600px) {
    dialog {
      margin-top: 1rem;
      padding: 1.25rem;
      max-height: 88dvh;
    }
    input {
      font-size: 1.4rem;
    }
  }
</style>
