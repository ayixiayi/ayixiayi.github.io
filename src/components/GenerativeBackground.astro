---
---

<div id="generative-bg"></div>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.7.0/p5.min.js"></script>
<script is:inline>
  // Luminous Erosion — full-fidelity p5.js background
  // Random seed on every page load, no controls exposed

  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var isMobile = window.innerWidth < 768;
    var PARTICLE_COUNT = isMobile ? 1500 : 4000;

    var params = {
      seed: Math.floor(Math.random() * 999999) + 1,
      noiseScale: 0.004,
      flowForce: 1.0,
      erosionRate: isMobile ? 12 : 8,
      maxSpeed: 3.5,
      trailOpacity: 20,
      colorSlow: [217, 119, 87],
      colorMid: [232, 220, 200],
      colorFast: [106, 155, 204]
    };

    var particles = [];
    var noiseZOffset = 0;

    new p5(function (p) {
      p.setup = function () {
        var canvas = p.createCanvas(p.windowWidth, p.windowHeight);
        canvas.parent('generative-bg');
        p.colorMode(p.RGB, 255, 255, 255, 255);
        p.pixelDensity(Math.min(window.devicePixelRatio || 1, 2));
        initializeSystem(p);
      };

      p.windowResized = function () {
        p.resizeCanvas(p.windowWidth, p.windowHeight);
        initializeSystem(p);
      };

      p.draw = function () {
        // Erosion veil — darkness slowly reclaims
        p.noStroke();
        p.fill(10, 10, 12, params.erosionRate);
        p.rect(0, 0, p.width, p.height);

        // Advance noise field slowly for subtle temporal drift
        noiseZOffset += 0.0003;

        for (var i = 0; i < particles.length; i++) {
          var pt = particles[i];
          follow(p, pt);
          update(pt);
          display(p, pt);
          edges(p, pt);
        }
      };
    });

    function initializeSystem(p) {
      p.randomSeed(params.seed);
      p.noiseSeed(params.seed);
      noiseZOffset = 0;

      particles = [];
      for (var i = 0; i < PARTICLE_COUNT; i++) {
        particles.push({
          x: p.random(p.width),
          y: p.random(p.height),
          px: 0, py: 0,
          vx: 0, vy: 0,
          maxSpeed: params.maxSpeed
        });
      }
      for (var j = 0; j < particles.length; j++) {
        particles[j].px = particles[j].x;
        particles[j].py = particles[j].y;
      }

      p.background(10, 10, 12);
    }

    function follow(p, pt) {
      var x = pt.x * params.noiseScale;
      var y = pt.y * params.noiseScale;

      // Multi-octave noise for richer flow topology (matches original art.html)
      var angle1 = p.noise(x, y, noiseZOffset) * p.TWO_PI * 2;
      var angle2 = p.noise(x * 2.3 + 100, y * 2.3 + 100, noiseZOffset * 0.7) * p.TWO_PI;
      var blended = angle1 * 0.7 + angle2 * 0.3;

      var forceMag = params.flowForce * 0.15;
      pt.vx += Math.cos(blended) * forceMag;
      pt.vy += Math.sin(blended) * forceMag;
    }

    function update(pt) {
      pt.px = pt.x;
      pt.py = pt.y;
      var speed = Math.sqrt(pt.vx * pt.vx + pt.vy * pt.vy);
      if (speed > pt.maxSpeed) {
        pt.vx = (pt.vx / speed) * pt.maxSpeed;
        pt.vy = (pt.vy / speed) * pt.maxSpeed;
      }
      pt.x += pt.vx;
      pt.y += pt.vy;
    }

    function display(p, pt) {
      var speed = Math.sqrt(pt.vx * pt.vx + pt.vy * pt.vy);
      var sn = Math.min(speed / pt.maxSpeed, 1);

      var cs = params.colorSlow;
      var cm = params.colorMid;
      var cf = params.colorFast;

      var r, g, b;
      if (sn < 0.5) {
        var t = sn * 2;
        r = cs[0] + (cm[0] - cs[0]) * t;
        g = cs[1] + (cm[1] - cs[1]) * t;
        b = cs[2] + (cm[2] - cs[2]) * t;
      } else {
        var t2 = (sn - 0.5) * 2;
        r = cm[0] + (cf[0] - cm[0]) * t2;
        g = cm[1] + (cf[1] - cm[1]) * t2;
        b = cm[2] + (cf[2] - cm[2]) * t2;
      }

      var alpha = params.trailOpacity * (0.4 + sn * 0.6);

      p.stroke(r, g, b, alpha);
      p.strokeWeight(sn < 0.3 ? 1.5 : 1);
      p.line(pt.px, pt.py, pt.x, pt.y);
    }

    function edges(p, pt) {
      var respawned = false;
      if (pt.x > p.width) { pt.x = 0; respawned = true; }
      if (pt.x < 0) { pt.x = p.width; respawned = true; }
      if (pt.y > p.height) { pt.y = 0; respawned = true; }
      if (pt.y < 0) { pt.y = p.height; respawned = true; }
      if (respawned) {
        pt.px = pt.x;
        pt.py = pt.y;
      }
    }
  })();
</script>

<style>
  #generative-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    background: #0a0a0c;
  }

  #generative-bg :global(canvas) {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
  }
</style>
