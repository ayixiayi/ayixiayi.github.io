---
import type { TimelineEntry } from '../lib/projects';

interface Props {
  entries: TimelineEntry[];
}
const { entries } = Astro.props;
const years = [...new Set(entries.map((entry) => entry.date.getUTCFullYear()))];
const formatMonthDay = (date: Date) =>
  date.toISOString().slice(5, 10).replace('-', '.');
---

{entries.length > 0 && (
  <section class="container chronology" aria-labelledby="chronology-title">
    <h2 id="chronology-title">年表</h2>
    <div class="chrono-groups">
      {years.map((year) => (
        <div class="chrono-group">
          <h3 class="chrono-year">{year}</h3>
          <ol class="chrono-list">
            {entries
              .filter((entry) => entry.date.getUTCFullYear() === year)
              .map((entry) => (
                <li
                  class:list={[
                    'chrono-item',
                    entry.kind === 'project' ? 'is-project' : 'is-post',
                  ]}
                >
                  <time datetime={entry.date.toISOString().slice(0, 10)}>
                    {formatMonthDay(entry.date)}
                  </time>
                  <span class="chrono-kind">{entry.kindLabel}</span>
                  <a class="chrono-title" href={entry.url}>
                    {entry.title}
                  </a>
                </li>
              ))}
          </ol>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .chronology {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 720px);
    gap: var(--gap);
    align-items: start;
    padding-top: 48px;
    padding-bottom: 120px;
    border-top: 1px solid var(--rule);
  }
  .chronology h2 {
    position: sticky;
    top: 110px;
    font: 400 28px / 1.3 var(--font-display-cjk);
    color: var(--snow);
  }
  .chronology h2::before {
    content: '';
    display: block;
    width: 24px;
    height: 1px;
    background: var(--gold);
    margin-bottom: 16px;
  }
  .chrono-year {
    font: italic 400 44px / 1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--mist);
  }
  .chrono-list {
    list-style: none;
    margin: 16px 0 40px;
    padding: 0 0 0 22px;
    border-left: 1px solid var(--rule);
  }
  .chrono-group:last-child .chrono-list {
    margin-bottom: 0;
  }
  .chrono-item {
    position: relative;
    display: grid;
    grid-template-columns: 56px auto minmax(0, 1fr);
    gap: 4px 16px;
    align-items: baseline;
    padding: 12px 0;
  }
  .chrono-item::before {
    content: '';
    position: absolute;
    left: -26px;
    top: 1.15em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    border: 1px solid var(--mist);
  }
  .chrono-item.is-project::before {
    background: var(--gold);
    border-color: var(--gold);
  }
  .chrono-item time {
    font: 12px var(--font-mono);
    color: var(--mist);
  }
  .chrono-kind {
    font: 11px var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--gold);
  }
  .chrono-title {
    font: 400 19px / 1.5 var(--font-display-cjk);
    color: var(--snow);
    transition: color var(--dur-1) ease;
  }
  .chrono-title:hover {
    color: var(--gold);
  }
  @media (max-width: 800px) {
    .chronology {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-bottom: 84px;
    }
    .chronology h2 {
      position: static;
    }
    .chrono-item {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .chrono-title {
      grid-column: 1 / -1;
      font-size: 17px;
    }
  }
</style>
