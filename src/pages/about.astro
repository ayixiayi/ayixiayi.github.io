---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About - YourName" description="About me">
  <main class="container">
    <div class="page-header">
      <h1>About</h1>
    </div>
    <div class="prose">
      <p>
        Hi! I'm <strong>YourName</strong>. I'm interested in building things
        for the web and exploring the intersection of technology and creativity.
      </p>
      <p>
        This site is built with <a href="https://astro.build">Astro</a> and
        features a generative art background powered by simplex noise and
        vanilla Canvas — ported from a p5.js algorithmic art piece.
      </p>
      <h2>Links</h2>
      <ul>
        <li><a href="https://github.com/yourusername" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="mailto:your@email.com">Email</a></li>
      </ul>
    </div>
  </main>
</BaseLayout>
