---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import {
  getPublishedPosts,
  formatDate,
  readingMinutes,
  displayTag,
} from '../../lib/posts';
import Icon from '../../components/Icon.astro';
import Chapter from '../../components/Chapter.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter((heading) => heading.depth <= 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article
  publishedAt={post.data.pubDate}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <main id="main" class="article-page">
    <Chapter short focus="72% 36%">
      <a href="/blog/" class="text-link back-link">
        <Icon name="back" size={17} />
        返回博客
      </a>
      <div class="article-header">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span>约 {readingMinutes(post.body)} 分钟阅读</span>
        </div>
        <h1>{post.data.title}</h1>
        <div class="project-tags">
          {post.data.tags?.map((tag) => (
            <span>{displayTag(tag)}</span>
          ))}
        </div>
      </div>
    </Chapter>
    <div class="container article-body">
      <div class="article-grid">
        <article class="prose">
          <Content />
        </article>
        {contents.length > 0 && (
          <aside class="toc">
            <nav aria-label="文章目录">
              <p class="toc-title">目录</p>
              <ol>
                {contents.map((heading) => (
                  <li class:list={{ nested: heading.depth > 1 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
            <a href="#main" class="text-link">
              回到顶部 ↑
            </a>
          </aside>
        )}
      </div>
      <div class="page-end">
        <a href="/blog/" class="text-link">
          <Icon name="back" size={17} />
          全部文章
        </a>
        <a href="/rss.xml" class="text-link">
          <Icon name="rss" size={15} />
          订阅更新
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // Mark the section being read so the contents double as a quiet position marker.
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]'),
  ];
  const targets = links
    .map((link) =>
      document.getElementById(decodeURIComponent(link.hash.slice(1))),
    )
    .filter((target): target is HTMLElement => target !== null);
  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const update = () => {
      const current =
        targets.find((target) => visible.has(target)) ??
        [...targets]
          .reverse()
          .find((target) => target.getBoundingClientRect().top < 0);
      for (const link of links)
        link.classList.toggle(
          'is-active',
          current !== undefined &&
            decodeURIComponent(link.hash.slice(1)) === current.id,
        );
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        }
        update();
      },
      { rootMargin: '0px 0px -55% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
  }
</script>
