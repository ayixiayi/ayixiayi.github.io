---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Chapter from '../../../components/Chapter.astro';
import BlogList from '../../../components/BlogList.astro';
import TagFilter from '../../../components/TagFilter.astro';
import {
  getPublishedPosts,
  tagCounts,
  tagKey,
  tagSlug,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = tagCounts(posts);
  return tags.map(({ tag }) => {
    const key = tagKey(tag);
    return {
      params: { tag: tagSlug(tag) },
      props: {
        tag,
        posts: posts.filter((post) =>
          post.data.tags.some((entry) => tagKey(entry) === key),
        ),
        tags,
      },
    };
  });
}

const { tag, posts, tags } = Astro.props;
---

<BaseLayout
  title={`标签：${tag}`}
  description={`ayixiayi 标记为「${tag}」的文章。`}
>
  <main id="main" class="blog-page">
    <Chapter numeral="II" focus="50% 8%" short>
      <h1>{tag}</h1>
      <p>{posts.length} 篇文章</p>
      <TagFilter tags={tags} current={tag} />
    </Chapter>
    <div class="container">
      <BlogList posts={posts} />
    </div>
  </main>
</BaseLayout>
