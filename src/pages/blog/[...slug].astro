---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import {
  getPublishedPosts,
  postUrl,
  formatDate,
  readingMinutes,
  cardUrl,
  demoteHeadingsHtml,
} from '../../lib/posts';
import PostTags from '../../components/PostTags.astro';
import Icon from '../../components/Icon.astro';
import Chapter from '../../components/Chapter.astro';
import ArticleColophon from '../../components/ArticleColophon.astro';
import Comments from '../../components/Comments.astro';

type ArticleLink = { title: string; url: string };

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const links = posts.map((post) => ({
    title: post.data.title,
    url: postUrl(post.id),
  }));
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: links[index - 1],
      older: links[index + 1],
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer?: ArticleLink;
  older?: ArticleLink;
}
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const hasTopH1 = headings.some((heading) => heading.depth === 1);
const rawHtml = post.rendered?.html;
const hasRelativeImages =
  (post.rendered?.metadata?.imagePaths?.length ?? 0) > 0;
const demotedHtml =
  hasTopH1 && rawHtml && !hasRelativeImages
    ? demoteHeadingsHtml(rawHtml)
    : undefined;
const contents = headings.filter((heading) => heading.depth <= 3);
const topDepth = contents.reduce(
  (depth, heading) => Math.min(depth, heading.depth),
  3,
);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article
  publishedAt={post.data.pubDate}
  image={{ path: cardUrl(post.id), alt: post.data.title }}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <main id="main" class="article-page">
    <Chapter short focus="72% 36%">
      <a href="/blog/" class="text-link back-link">
        <Icon name="back" size={17} />
        返回博客
      </a>
      <div class="article-header">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span>约 {readingMinutes(post.body)} 分钟阅读</span>
        </div>
        <h1>{post.data.title}</h1>
        <PostTags tags={post.data.tags} />
      </div>
    </Chapter>
    <div class="container article-body">
      <div class="article-grid">
        <article class="prose">
          {demotedHtml !== undefined ? (
            <Fragment set:html={demotedHtml} />
          ) : (
            <Content />
          )}
        </article>
        {contents.length > 0 && (
          <aside class="toc">
            <nav aria-label="文章目录">
              <p class="toc-title">目录</p>
              <ol>
                {contents.map((heading) => (
                  <li class:list={{ nested: heading.depth > topDepth }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
            <a href="#main" class="text-link">
              回到顶部 ↑
            </a>
          </aside>
        )}
      </div>
      {(newer || older) && (
        <nav class="article-neighbors" aria-label="相邻文章">
          {newer && (
            <a href={newer.url}>
              <span>
                <Icon name="back" size={16} /> 较新一篇
              </span>
              <strong>{newer.title}</strong>
            </a>
          )}
          {older && (
            <a href={older.url}>
              <span>
                较早一篇 <Icon name="arrow" size={16} />
              </span>
              <strong>{older.title}</strong>
            </a>
          )}
        </nav>
      )}
      <ArticleColophon
        pubDate={post.data.pubDate}
        updatedDate={post.data.updatedDate}
        tags={post.data.tags}
      />
      <Comments slug={post.id} enabled={post.data.comments} />
      <div class="page-end">
        <a href="/blog/" class="text-link">
          <Icon name="back" size={17} />
          全部文章
        </a>
        <a href="/rss.xml" class="text-link">
          <Icon name="rss" size={15} />
          订阅更新
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const decodeHashId = (hash: string) => {
    const raw = hash.slice(1);
    try {
      return decodeURIComponent(raw);
    } catch {
      return raw;
    }
  };

  // Mark the section being read so the contents double as a quiet position marker.
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>('.toc nav a[href^="#"]'),
  ];
  const targets = links
    .map((link) => document.getElementById(decodeHashId(link.hash)))
    .filter((target): target is HTMLElement => target !== null);
  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const update = () => {
      const current =
        targets.find((target) => visible.has(target)) ??
        [...targets]
          .reverse()
          .find((target) => target.getBoundingClientRect().top < 0);
      for (const link of links)
        link.classList.toggle(
          'is-active',
          current !== undefined && decodeHashId(link.hash) === current.id,
        );
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        }
        update();
      },
      { rootMargin: '0px 0px -55% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
  }
</script>
