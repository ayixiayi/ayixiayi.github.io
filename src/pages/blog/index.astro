---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chapter from '../../components/Chapter.astro';
import BlogList from '../../components/BlogList.astro';
import TagFilter from '../../components/TagFilter.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedPosts, tagCounts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="博客" description="ayixiayi 的文章列表。">
  <main id="main" class="blog-page">
    <Chapter numeral="II" focus="50% 8%">
      <h1>博客</h1>
      <p>学到的和想到的。</p>
      <a href="/rss.xml" class="text-link rss-link">
        <Icon name="rss" size={16} />
        RSS
      </a>
      <TagFilter tags={tagCounts(posts)} />
    </Chapter>
    <div class="container">
      <BlogList posts={posts} />
    </div>
  </main>
</BaseLayout>
