---
import BaseLayout from '../layouts/BaseLayout.astro';
import GenerativeLandscape from '../components/GenerativeLandscape.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { projects, site } from '../data/site';
import {
  getPublishedPosts,
  postUrl,
  formatDate,
  readingMinutes,
} from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={site.name}>
  <main id="main">
    <section class="hero" aria-labelledby="intro-title">
      <GenerativeLandscape>
        <div class="hero-copy">
          <h1 id="intro-title">
            ayixiayi
            <span class="signature-dot" aria-hidden="true">
              .
            </span>
          </h1>
          <p class="hero-subtitle">SJTU 自动化 · Sophomore</p>
          <p class="hero-description">兴趣导向型开发者</p>
        </div>
      </GenerativeLandscape>
    </section>

    <div class="home-content">
      <section class="home-section" aria-labelledby="projects-title">
        <div class="section-heading">
          <h2 id="projects-title">项目</h2>
          <a href="/projects/" class="text-link">
            全部项目 <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="project-grid">
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>

      <section
        class="home-section writing-section"
        aria-labelledby="writing-title"
      >
        <div class="section-heading">
          <h2 id="writing-title">博客</h2>
          <a href="/blog/" class="text-link">
            全部文章 <Icon name="arrow" size={16} />
          </a>
        </div>
        {posts.map((post) => (
          <a class="post-row" href={postUrl(post.id)}>
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <h3>{post.data.title}</h3>
            <span class="reading-time">
              约 {readingMinutes(post.body)} 分钟
            </span>
            <Icon name="external" size={22} />
          </a>
        ))}
        {posts.length === 0 && <p class="muted">暂无文章。</p>}
      </section>
    </div>
  </main>
</BaseLayout>
