---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="页面不存在" description="请求的页面不存在。" noindex>
  <main id="main" class="not-found">
    <div class="not-found-art" aria-hidden="true">
      <img
        src="/images/landscape.webp"
        alt=""
        width="1600"
        height="1000"
        decoding="async"
      />
    </div>
    <div class="not-found-copy">
      <p class="not-found-code">404</p>
      <h1>页面不存在</h1>
      <div class="not-found-actions">
        <a href="/" class="hero-primary">
          返回首页 <Icon name="arrow" size={16} />
        </a>
        <a href="/projects/" class="text-link">
          项目
        </a>
        <a href="/blog/" class="text-link">
          博客
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
